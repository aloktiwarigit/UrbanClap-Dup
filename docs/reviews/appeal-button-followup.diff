diff --git a/technician-app/app/src/testDebug/kotlin/com/homeservices/technician/ui/myratings/MyRatingsAppealInteractionTest.kt b/technician-app/app/src/testDebug/kotlin/com/homeservices/technician/ui/myratings/MyRatingsAppealInteractionTest.kt
