# Sentry — server (private)
SENTRY_DSN=

# Sentry — client (public — must start with NEXT_PUBLIC_)
NEXT_PUBLIC_SENTRY_DSN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# GrowthBook (OSS feature flags — runs client-side)
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=
NEXT_PUBLIC_GROWTHBOOK_API_HOST=

# Firebase (client-side auth — required; empty string causes auth/invalid-api-key before network)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Firebase Messaging — required for FCM Web Push getToken(); find in Firebase Console → Project settings → General
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Firebase App ID — required for Web Push and Firebase Performance; find in Firebase Console → Project settings → General
NEXT_PUBLIC_FIREBASE_APP_ID=
# FCM Web Push — VAPID public key from Firebase Console → Project settings → Cloud Messaging → Web Push certificates
# If omitted, push registration is silently skipped (auth still works normally).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_GIT_SHA=
JWT_SECRET=local-dev-jwt-secret-placeholder-min32chars

# Server-side API target. Browser calls use /admin-api by default so SWA Free
# does not need a linked backend for five-user admin usage.
API_BASE_URL=http://localhost:7071/api
